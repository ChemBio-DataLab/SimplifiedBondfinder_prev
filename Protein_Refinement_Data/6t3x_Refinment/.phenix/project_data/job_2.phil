job {
  job_id = 2
  app_id = Refine
  program_name = None
  title = """[ phenix.refine ]"""
  directory = "$(LIBTBX_BASE_DIR)/Refine_2"
  process_type = None
  hostname = None
  queue_id = None
  citation = None
  input_file {
    file_name = "$(LIBTBX_BASE_DIR)/ReadySet_1/6t3xNOS-All_at_once_refine_4.updated.pdb"
    file_type = Input model
    param_name = refinement.input.pdb.file_name
  }
  input_file {
    file_name = "$(LIBTBX_BASE_DIR)/6t3x_final.mtz"
    file_type = Reflections file
    param_name = refinement.input.xray_data.file_name
  }
  input_file {
    file_name = "$(LIBTBX_BASE_DIR)/6t3x_final.mtz"
    file_type = File with R(free) flags
    param_name = refinement.input.xray_data.r_free_flags.file_name
  }
  input_file {
    file_name = "$(LIBTBX_BASE_DIR)/ReadySet_1/6t3xNOS-All_at_once_refine_4.link.edits"
    file_type = Parameter file
    param_name = refinement.gui.phil_file
  }
  output_file {
    file_name = "6t3x-input_refine_2.eff"
    file_type = Effective parameters for this run
  }
  output_file {
    file_name = "6t3x-input_refine_2.cif"
    file_type = mmCIF model for PDB deposition
  }
  output_file {
    file_name = "6t3x-input_refine_2_info.txt"
    file_type = Run summary in text format
  }
  output_file {
    file_name = "6t3x-input_refine_2.pdb"
    file_type = Refined model
  }
  output_file {
    file_name = "6t3x-input_refine_2.mtz"
    file_type = Map coefficients for Coot
  }
  output_file {
    file_name = "6t3x-input_refine_2.geo"
    file_type = Geometry restraints before refinement
  }
  output_file {
    file_name = "6t3x-input_refine_2.log"
    file_type = phenix.refine log file
  }
  statistic {
    stat_name = R-work
    stat_value = 0.2077
  }
  statistic {
    stat_name = R-free
    stat_value = 0.2513
  }
  statistic {
    stat_name = RMSbonds
    stat_value = 0.010
  }
  statistic {
    stat_name = RMSangles
    stat_value = 1.097
  }
  statistic {
    stat_name = Clashscore
    stat_value = 2.7
  }
  statistic {
    stat_name = MolProbity score
